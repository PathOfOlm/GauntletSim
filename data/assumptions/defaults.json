{
  "meta": {
    "schema_version": 1,
    "notes": "Labeled assumptions only. Not facts. Ranges support later sensitivity analysis."
  },
  "assumptions": [
    {
      "id": "A-EXPLORE-01",
      "label": "Ticks to light a new room with the sceptre",
      "parameter": "exploration.room_light_ticks",
      "default": 1,
      "range": {"min": 1, "max": 3},
      "unit": "ticks"
    },
    {
      "id": "A-EXPLORE-02",
      "label": "Probability an orthogonal adjacent room edge is passable",
      "parameter": "dungeon.edge_passable_probability",
      "default": 0.95,
      "range": {"min": 0.7, "max": 1.0},
      "unit": "probability"
    },
    {
      "id": "A-GEN-NODES-01",
      "label": "Weights for node count 0..5 per resource room",
      "parameter": "dungeon.node_count_weights",
      "default": [0.05, 0.15, 0.25, 0.3, 0.15, 0.1],
      "range": {"description": "6 non-negative weights summing to 1"},
      "unit": "categorical_weights"
    },
    {
      "id": "A-GEN-FISH-01",
      "label": "Policy for placing the guaranteed 3-fishing-spot room",
      "parameter": "dungeon.guaranteed_fish_room_policy",
      "default": "inner_ring_uniform",
      "range": {"choices": ["inner_ring_uniform", "any_resource_uniform"]},
      "unit": "enum"
    },
    {
      "id": "A-DEMI-SPAWN-01",
      "label": "Extra demi-boss rooms beyond four cardinal guarantees",
      "parameter": "dungeon.demi_boss_extra_count",
      "default": 2,
      "range": {"min": 0, "max": 4},
      "unit": "count"
    },
    {
      "id": "A-DEMI-SPAWN-02",
      "label": "Demi-boss type weights bear/dragon/dark_beast",
      "parameter": "dungeon.demi_boss_type_weights",
      "default": {"bear": 0.333, "dragon": 0.333, "dark_beast": 0.334},
      "range": {"description": "each weight 0.2–0.5, sum 1"},
      "unit": "categorical_weights"
    },
    {
      "id": "A-MOB-STATS-01",
      "label": "Scale factor on crystalline mob baselines for Corrupted stats",
      "parameter": "combat.corrupted_mob_stat_scale",
